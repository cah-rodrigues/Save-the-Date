# Cabecalhos aplicados pela Cloudflare Pages.
# Regras mais especificas somam com a regra /*.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# Bundles do Vite: tem hash no nome, entao nunca mudam de conteudo.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Fotos e icones de public/assets: nome fixo, precisam revalidar para que
# trocar uma foto no repositorio apareca para quem ja visitou o site.
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate
